+---
+// The live istheldown figure on /projects. public/assets/subway-vis.js draws
+// it and sets .figs[data-state] to "ready" once it has.
+---
+<p class="live-caption"><small id="subway-vis-caption" role="status">Loading live transit preview…</small></p>
+<div class="figs" data-state="loading">
+    <div class="fig"><canvas id="subway-vis" aria-label="Generative figure driven by one subway line's live train positions"></canvas></div>
+    <div class="fig map"><canvas id="subway-map" width="520" height="650" aria-label="Map of every subway train right now, with the chosen line highlighted"></canvas></div>
+</div>
+
+<style>
+    /* Same 260px width as the images on the homepage */
+    .figs { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; margin-top: 8px; }
+    .fig { width: 260px; max-width: 100%; aspect-ratio: 4 / 5; background: color-mix(in srgb, currentColor 6%, var(--bg, Canvas)); box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 12%, transparent); }
+    canvas { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 240ms ease-out; }
+    .figs[data-state="ready"] canvas { opacity: 1; }
+    .figs:not([data-state="ready"]) canvas { visibility: hidden; }
+    @media (prefers-reduced-motion: reduce) { canvas { transition: none; } }
+    /* Keep the caption and both figures in flow while the feed loads or fails */
+    .live-caption { margin-bottom: 0; }
+    small { display: block; min-height: calc(3.2em + 1px); line-height: 1.6; }
+    @media (min-width: 600px) { small { min-height: calc(1.6em + 1px); } }
+    /* The subway line's bullet, which subway-vis.js adds to the caption */
+    small :global(.bullet) { width: 1.4em; height: 1.4em; vertical-align: middle; }
+</style>
diff --git a/site/components/SubwayHead.astro b/site/components/SubwayHead.astro
new file mode 100644
index 0000000..5a3c143
--- /dev/null
+++ b/site/components/SubwayHead.astro
@@ -0,0 +1,32 @@
+---
+// What the subway-vis figure needs in <head>, ahead of the renderer: open the
+// istheldown feed and fetch the station table early, and preload Hydra.
+// public/assets/subway-vis.js's header comment documents the whole figure.
+---
+<link rel="preconnect" href="https://istheldown.com">
+<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
+<script is:inline>
+    // Register before the first paint; defer WebGL work until the page fade is over.
+    window.__pageTransitionFinished = new Promise(function (resolve) {
+        if (!('onpagereveal' in window)) { resolve(); return; }
+        window.addEventListener('pagereveal', function (event) {
+            if (event.viewTransition) event.viewTransition.finished.then(resolve, resolve);
+            else resolve();
+        }, { once: true });
+    });
+    // Open the istheldown feed and fetch the station table right away, before the
+    // renderer has loaded; assets/subway-vis.js picks these up (messages are queued).
+    window.__subway = (function () {
+        try {
+            var s = { ws: new WebSocket('wss://istheldown.com/ws?systems=subway&alerts=subway'), queue: [], closed: null, t0: performance.now() };
+            s.onmsg = function (e) { s.queue.push(e.data); };
+            s.ws.addEventListener('message', s.onmsg);
+            s.ws.addEventListener('close', function (e) { s.closed = e.code; });
+            s.stations = fetch('/assets/subway-stations.json').then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
+            s.stations.catch(function () {});
+            return s;
+        } catch (e) { return null; }
+    })();
+</script>
+<link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/hydra-synth@1.4.0/dist/hydra-synth.js">
+<script is:inline src="/assets/subway-vis.js" defer></script>
