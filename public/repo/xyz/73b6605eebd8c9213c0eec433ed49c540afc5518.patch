-
-def render_sitemap_xml(pages) -> str:
-    lines = [
-        '<?xml version="1.0" encoding="UTF-8"?>',
-        '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">',
-    ]
-    for page in pages:
-        lines += ["  <url>", f"    <loc>{xml_escape(page.url)}</loc>"]
-        if page.lastmod:
