--- /dev/null
+++ b/site/layouts/Post.astro
@@ -0,0 +1,43 @@
+---
+// A post in site/content/writing/: its title and date over the content, in
+// the shared page layout. site/pages/writing/[slug].astro renders each post.
+import Page from "./Page.astro";
+import { formatDate, type Post } from "../lib/writing.ts";
+
+interface Props {
+    post: Post;
+}
+
+const { post } = Astro.props;
+const { title, description, date, draft } = post.data;
+const url = new URL(`/writing/${post.id}`, Astro.site).href;
+// So search engines and AI crawlers can read the title, date and author
+const jsonLd = {
+    "@context": "https://schema.org",
+    "@type": "BlogPosting",
+    headline: title,
+    description,
+    datePublished: formatDate(date),
+    url,
+    author: { "@type": "Person", name: "Alex Kan", url: new URL("/", Astro.site).href },
+};
+---
+<Page title={`${title} | alexkan.xyz`} description={description}>
+    <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
+    <article>
+        <h1>{title}</h1>
+        <p class="byline">
+            <time datetime={formatDate(date)}>{formatDate(date)}</time>
+            {draft && <strong> · Draft (shown in dev only)</strong>}
+        </p>
+        <slot />
+    </article>
+    <p><a class="button" href="/writing">All Writing</a></p>
+</Page>
+
+<style>
+    article { max-width: 65ch; line-height: 1.6; }
+    h1 { font-size: 1.6em; line-height: 1.2; margin: 0 0 4px; }
+    .byline { color: var(--muted, #666); margin: 0 0 2em; }
+    article :global(img) { max-width: 100%; height: auto; }
+</style>
diff --git a/site/lib/writing.ts b/site/lib/writing.ts
new file mode 100644
index 0000000..fd4bc7b
--- /dev/null
+++ b/site/lib/writing.ts
@@ -0,0 +1,12 @@
+import { getCollection, type CollectionEntry } from "astro:content";
+
+export type Post = CollectionEntry<"writing">;
+
+/** Posts, newest first. Drafts are included only in `npm run dev`. */
+export async function getPosts(): Promise<Post[]> {
+    const posts = await getCollection("writing", ({ data }) => import.meta.env.DEV || !data.draft);
+    return posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+}
+
+/** 2026-10-07 */
+export const formatDate = (date: Date) => date.toISOString().slice(0, 10);
