new file mode 100644
index 0000000..3cfe0c0
--- /dev/null
+++ b/site/pages/writing/[slug].astro
@@ -0,0 +1,18 @@
+---
+import type { GetStaticPaths } from "astro";
+import { render } from "astro:content";
+import Post from "../../layouts/Post.astro";
+import { getPosts, type Post as PostEntry } from "../../lib/writing.ts";
+
+// One page per post: site/content/writing/my-post.mdx -> /writing/my-post
+export const getStaticPaths = (async () => {
+    const posts = await getPosts();
+    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
+}) satisfies GetStaticPaths;
+
+const { post } = Astro.props as { post: PostEntry };
+const { Content } = await render(post);
+---
+<Post post={post}>
+    <Content />
+</Post>
