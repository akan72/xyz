+# The Worker's only config. Pushes to master deploy it to production with
+# `wrangler deploy`, and each PR gets a Worker Preview of it with
+# `wrangler preview --name pr-<N>` (.github/workflows/deploy.yml). The
+# [[routes]] below only ever apply to production; previews answer only at
+# their own workers.dev URL. Previews inherit none of the bindings, so the
+# [previews] block at the end declares them again (scripts/test_previews.py
+# checks it).
 name = "xyz"
 main = "build/worker/shim.mjs"
 compatibility_date = "2026-05-01"
 
+# Production answers only at the custom domains in [[routes]], not at
+# xyz.<subdomain>.workers.dev. Preview URLs stay on, because a Worker Preview
+# only gets its pr-<N>-xyz.<subdomain>.workers.dev URL when they are; with
+# custom domains, both would default to off. Production deploys (and
+# `wrangler triggers deploy`) apply these two settings; `wrangler preview`
+# doesn't.
+workers_dev = false
+preview_urls = true
+
