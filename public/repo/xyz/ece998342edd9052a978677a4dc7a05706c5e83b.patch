+<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
+<style>
+    :root {
+        --ground: #FAFAF7;
+        --raised: #F0F0EA;
+        --ink: #16171A;
+        --muted: #5C5F66;
+        --rule: #DCDCD4;
+        --accent: #D212AF;
+        --accent-ink: #FFFFFF;
+        --serif: Georgia, "Times New Roman", serif;
+        --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
+    }
+    @media (prefers-color-scheme: dark) {
+        :root:not([data-theme="light"]) {
+            color-scheme: dark;
+            --ground: #111214;
+            --raised: #1A1B1F;
+            --ink: #EDEDE8;
+            --muted: #9B9DA4;
+            --rule: #2B2D32;
+            --accent: #FF4FD8;
+            --accent-ink: #111214;
+        }
+    }
+    :root[data-theme="dark"] {
+        color-scheme: dark;
+        --ground: #111214;
+        --raised: #1A1B1F;
+        --ink: #EDEDE8;
+        --muted: #9B9DA4;
+        --rule: #2B2D32;
+        --accent: #FF4FD8;
+        --accent-ink: #111214;
+    }
+
+    body {
+        margin: 0;
+        background: var(--ground);
+        color: var(--ink);
+        font: 17px/1.55 var(--serif);
+    }
+    .page {
+        max-width: 1040px;
+        margin: 0 auto;
+        padding-inline: 20px;
+        padding-block: 40px 72px;
+        display: grid;
+        gap: 56px;
+    }
+    h1, h2 {
+        margin: 0;
+        font-weight: 700;
+        line-height: 1.15;
+        text-wrap: balance;
+    }
+    h1 { font-size: 36px; }
+    h2 { font-size: 24px; }
+    p { margin: 0; }
+    code, .mono {
+        font-family: var(--mono);
+        font-size: 0.86em;
+    }
+    img {
+        display: block;
+        width: 100%;
+        max-width: 100%;
+        height: auto;
+    }
+
+    .intro {
+        display: grid;
+        gap: 18px;
+    }
+    .mark {
+        width: 96px;
+        aspect-ratio: 550 / 260;
+        background: var(--accent);
+        -webkit-mask: url("xyz.svg") center / contain no-repeat;
+        mask: url("xyz.svg") center / contain no-repeat;
+    }
+    .lede {
+        max-width: 64ch;
+        color: var(--ink);
+    }
+    .facts {
+        display: flex;
+        flex-wrap: wrap;
+        gap: 12px 40px;
+        margin: 6px 0 0;
+        padding-top: 18px;
+        border-top: 1px solid var(--rule);
+    }
+    .facts div {
+        display: grid;
+        gap: 2px;
+    }
+    .facts dt {
+        font: 600 11px/1.4 var(--mono);
+        letter-spacing: 0.08em;
+        text-transform: uppercase;
+        color: var(--muted);
+    }
+    .facts dd {
+        margin: 0;
+        font: 15px/1.4 var(--mono);
+    }
+
+    section {
+        display: grid;
+        gap: 18px;
+    }
+    .section-head {
+        display: grid;
+        gap: 6px;
+    }
+    .section-head p {
+        color: var(--muted);
+        max-width: 64ch;
+    }
+
+    .levels {
+        display: grid;
+        grid-template-columns: repeat(11, minmax(0, 1fr));
+        gap: 6px;
+        margin: 0;
+        padding: 0;
+        border: 0;
+    }
+    .seg { position: relative; }
+    .seg input {
+        position: absolute;
+        opacity: 0;
+        width: 1px;
+        height: 1px;
+        margin: 0;
+    }
+    .seg label {
+        position: relative;
+        display: block;
+        padding: 10px 0;
+        text-align: center;
+        font: 600 15px/1 var(--mono);
+        font-variant-numeric: tabular-nums;
+        color: var(--ink);
+        background: var(--raised);
+        border: 1px solid var(--rule);
+        border-radius: 6px;
+        cursor: pointer;
+    }
+    .seg label:hover { border-color: var(--accent); }
+    .seg input:checked + label {
+        background: var(--accent);
+        border-color: var(--accent);
+        color: var(--accent-ink);
+    }
+    .seg input:focus-visible + label {
+        outline: 2px solid var(--accent);
+        outline-offset: 2px;
+    }
+    .seg label.is-current::after {
+        content: "";
+        position: absolute;
+        top: 5px;
+        right: 5px;
+        width: 5px;
+        height: 5px;
+        border-radius: 50%;
+        background: currentColor;
+    }
+    .levels-note {
+        font: 13px/1.4 var(--mono);
+        color: var(--muted);
+    }
+
+    .clip {
+        margin: 0;
+        border: 1px solid var(--rule);
+        border-radius: 6px;
+        overflow: hidden;
+        background: var(--raised);
+    }
+    .viewer-caption {
+        display: grid;
+        gap: 10px;
+    }
+    .reading {
+        display: flex;
+        align-items: baseline;
+        flex-wrap: wrap;
+        gap: 4px 14px;
+    }
+    .reading .value {
+        font: 600 30px/1 var(--mono);
+        font-variant-numeric: tabular-nums;
+        color: var(--accent);
+    }
+    .formulas {
+        display: grid;
+        gap: 4px;
+        margin: 0;
+        overflow-x: auto;
+    }
+    .formulas div {
+        display: flex;
+        gap: 12px;
+        white-space: nowrap;
+    }
+    .formulas dt {
+        width: 3.5em;
+        font: 13px/1.6 var(--mono);
+        color: var(--muted);
+    }
+    .formulas dd {
+        margin: 0;
+        font: 13px/1.6 var(--mono);
+    }
+
+    .grid {
+        display: grid;
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+        gap: 20px;
+        margin: 0;
+        padding: 0;
+        list-style: none;
+    }
+    .grid .baseline { grid-column: 1 / -1; }
+    .tile {
+        display: grid;
+        gap: 8px;
+        width: 100%;
+        padding: 0;
+        border: 0;
+        background: none;
+        color: inherit;
+        font: inherit;
+        text-align: left;
+        cursor: pointer;
+    }
+    .tile .clip { transition: border-color 120ms ease; }
+    .tile:hover .clip { border-color: var(--accent); }
+    .tile:focus-visible {
+        outline: 2px solid var(--accent);
+        outline-offset: 4px;
+        border-radius: 6px;
+    }
+    .tile-label {
+        display: flex;
+        gap: 10px;
+        align-items: baseline;
+    }
+    .tile-label .mono {
+        font-weight: 600;
+        font-size: 15px;
+        font-variant-numeric: tabular-nums;
+    }
+    .tile-label span:last-child {
+        font-size: 15px;
+        color: var(--muted);
+    }
+
+    h3 {
+        margin: 0;
+        font-size: 19px;
+        line-height: 1.2;
+        text-wrap: balance;
+    }
+    .halo-clips {
+        display: grid;
+        gap: 28px;
+    }
+    .halo-clip {
+        display: grid;
+        gap: 8px;
+        margin: 0;
+    }
+    .halo-clip figcaption,
+    .closeup-level {
+        font-weight: 600;
+        font-size: 15px;
+        font-variant-numeric: tabular-nums;
+        color: var(--accent);
+    }
+    .closeup-sets {
+        display: grid;
+        gap: 20px;
+    }
+    .closeup-set {
+        display: grid;
+        gap: 8px;
+    }
+    .closeups {
+        display: grid;
+        grid-template-columns: repeat(4, minmax(0, 1fr));
+        gap: 10px;
+    }
+    .closeups figure {
+        display: grid;
+        gap: 6px;
+        margin: 0;
+    }
+    .closeups img {
+        border: 1px solid var(--rule);
+        border-radius: 6px;
+    }
+    .closeups figcaption {
+        font: 13px/1.4 var(--mono);
+        color: var(--muted);
+    }
+
+    .colophon {
+        padding-top: 18px;
