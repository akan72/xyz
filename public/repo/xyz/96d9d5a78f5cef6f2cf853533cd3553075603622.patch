   assert.equal(s.overlays[0].hidden, true);
 });
+
+test('input inside the mingus frame restarts the idle period; other messages do not', async () => {
+  const s = await saver(); const originalTimer = [...s.timers.keys()][0];
+  const message = s.browserEvents.message[0];
+  message({ origin: 'https://evil.example', data: { type: 'mingus:activity' } });
+  message({ origin: 'https://alexkan.xyz', data: { type: 'something-else' } });
+  assert.equal(s.timers.has(originalTimer), true);
+  message({ origin: 'https://alexkan.xyz', data: { type: 'mingus:activity' } });
+  assert.equal(s.timers.has(originalTimer), false);
+  assert.equal([...s.timers.values()][0].ms, 5000);
+});
+
+test('a frame message arriving after the saver starts leaves it up', async () => {
+  const s = await saver(); s.idle();
+  s.browserEvents.message[0]({ origin: 'https://alexkan.xyz', data: { type: 'mingus:activity' } });
+  assert.equal(s.overlays[0].hidden, false);
+});
diff --git a/site/components/MingusEmbed.astro b/site/components/MingusEmbed.astro
new file mode 100644
index 0000000..59cc281
--- /dev/null
+++ b/site/components/MingusEmbed.astro
@@ -0,0 +1,27 @@
+---
+// The live mingus taste map on /projects, which opens in its 3D layout by
+// default. ?embed shows only the map and posts input to this page, which
+// site/scripts/screensaver.js counts as activity. mingus is its own Worker,
+// routed only at alexkan.xyz/mingus in production (see its wrangler.toml). The absolute URL keeps PR
+// previews and `wrangler dev` from framing this site's own 404 page instead.
+---
+<figure class="mingus-embed">
+    <iframe
+        src="https://alexkan.xyz/mingus/?embed"
+        title="mingus: interactive 3D map of every artist I've listened to, clustered by genre"
+        loading="lazy"
+        referrerpolicy="no-referrer"
+    ></iframe>
+</figure>
+
+<style>
+    /* Same 536px width as the Vesta board (2 x 260px figures + 16px gap) */
+    .mingus-embed { width: 536px; max-width: 100%; margin: 1em 0; }
+    iframe {
+        display: block; width: 100%; aspect-ratio: 4 / 3; border: 0;
+        background: color-mix(in srgb, currentColor 6%, var(--bg, Canvas));
+        box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 12%, transparent);
+    }
+    /* Taller on phones, where the map's own controls take more of the frame */
+    @media (max-width: 600px) { iframe { aspect-ratio: 3 / 4; } }
+</style>
