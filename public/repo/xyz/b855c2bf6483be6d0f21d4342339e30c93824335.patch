+[[env.staging.durable_objects.bindings]]
+name = "VESTA_REFRESH"
+class_name = "VestaRefresh"
+[[env.staging.kv_namespaces]]
+binding = "VESTA_PRICES"
+id = "f47f1c49d816470ca5947468c050442c"
