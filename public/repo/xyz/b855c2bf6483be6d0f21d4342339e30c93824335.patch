+[[durable_objects.bindings]]
+name = "VESTA_REFRESH"
+class_name = "VestaRefresh"
+
+[[migrations]]
+tag = "v1"
+new_sqlite_classes = ["VestaRefresh"]
+
+# Shared only with the production xyz Worker, never a PR preview.
+[[kv_namespaces]]
+binding = "VESTA_PRICES"
+id = "1434bc71e28a4c5b90e15f6a57a1078c"
