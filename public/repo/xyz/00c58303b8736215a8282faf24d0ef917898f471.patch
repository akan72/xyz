+/// Origin for the absolute URLs in the tags. Production always names the bare
+/// domain, whichever host was asked; previews and local dev keep their own.
+/// Crawlers expect https even if the page was requested over http.
+pub fn origin(url: &Url) -> String {
+    match url.host_str() {
+        Some(SITE_HOST | WWW_HOST) => format!("https://{SITE_HOST}"),
+        Some("localhost" | "127.0.0.1") => url.origin().ascii_serialization(),
+        _ => url
+            .origin()
+            .ascii_serialization()
+            .replacen("http://", "https://", 1),
+    }
+}
