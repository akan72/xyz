+/// The canonical host. www answers too (a custom domain in wrangler.toml), but
+/// only to redirect here (src/lib.rs), so search engines see one copy of each page.
+pub const SITE_HOST: &str = "alexkan.xyz";
+pub const WWW_HOST: &str = "www.alexkan.xyz";
