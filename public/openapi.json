{
  "openapi": "3.1.1",
  "info": {
    "title": "alexkan.xyz Public Content API",
    "version": "1.0.0",
    "description": "Read Alex Kan’s published personal website pages. Hosted on Cloudflare Workers. No authentication or write operations. The separate MCP interface is documented at /docs. Unknown /api paths return a 404 Problem Details response, except retired /api/vesta routes which remain empty 404s.",
    "contact": {
      "name": "Alex Kan",
      "url": "https://alexkan.xyz/contact"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current deployment origin (production or preview)"
    }
  ],
  "security": [],
  "externalDocs": {
    "description": "alexkan.xyz developer resources for Rust and Cloudflare Workers",
    "url": "https://alexkan.xyz/docs"
  },
  "paths": {
    "/api": {
      "get": {
        "operationId": "discoverApi",
        "summary": "Discover alexkan.xyz public interfaces",
        "description": "Read-only and public. Unknown or duplicate query parameters return 400. No credentials required.",
        "responses": {
          "200": {
            "description": "Published public content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Discovery"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query; follow the resolution hint.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; use GET or HEAD.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Published content temporarily unavailable; retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "discoverApiHeaders",
        "summary": "Discover alexkan.xyz public interfaces (headers only)",
        "responses": {
          "200": {
            "description": "Published public content. HEAD responses have no body."
          },
          "400": {
            "description": "Invalid query; follow the resolution hint. HEAD responses have no body."
          },
          "405": {
            "description": "Unsupported method; use GET or HEAD. HEAD responses have no body."
          },
          "503": {
            "description": "Published content temporarily unavailable; retry later. HEAD responses have no body."
          }
        }
      }
    },
    "/api/pages": {
      "get": {
        "operationId": "listPages",
        "summary": "List all published alexkan.xyz pages",
        "description": "Read-only and public. Unknown or duplicate query parameters return 400. No credentials required.",
        "responses": {
          "200": {
            "description": "Published public content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query; follow the resolution hint.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; use GET or HEAD.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Published content temporarily unavailable; retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "listPagesHeaders",
        "summary": "List all published alexkan.xyz pages (headers only)",
        "responses": {
          "200": {
            "description": "Published public content. HEAD responses have no body."
          },
          "400": {
            "description": "Invalid query; follow the resolution hint. HEAD responses have no body."
          },
          "405": {
            "description": "Unsupported method; use GET or HEAD. HEAD responses have no body."
          },
          "503": {
            "description": "Published content temporarily unavailable; retry later. HEAD responses have no body."
          }
        }
      }
    },
    "/api/page": {
      "get": {
        "operationId": "readPage",
        "summary": "Read a published alexkan.xyz page as Markdown in JSON",
        "description": "Read-only and public. Unknown or duplicate query parameters return 400. No credentials required.",
        "responses": {
          "200": {
            "description": "Published public content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageContent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query; follow the resolution hint.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; use GET or HEAD.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Published content temporarily unavailable; retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The path is not a published page.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "readPageHeaders",
        "summary": "Read a published alexkan.xyz page as Markdown in JSON (headers only)",
        "responses": {
          "200": {
            "description": "Published public content. HEAD responses have no body."
          },
          "400": {
            "description": "Invalid query; follow the resolution hint. HEAD responses have no body."
          },
          "405": {
            "description": "Unsupported method; use GET or HEAD. HEAD responses have no body."
          },
          "503": {
            "description": "Published content temporarily unavailable; retry later. HEAD responses have no body."
          },
          "404": {
            "description": "The path is not a published page. HEAD responses have no body."
          }
        }
      },
      "parameters": [
        {
          "name": "path",
          "in": "query",
          "required": true,
          "description": "Exactly one canonical page path from GET /api/pages, including the leading slash.",
          "schema": {
            "type": "string",
            "pattern": "^/",
            "minLength": 1
          },
          "example": "/projects"
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "Discovery": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "docs": {
            "type": "string",
            "minLength": 1
          },
          "openapi": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "description",
          "docs",
          "openapi",
          "pages",
          "page"
        ],
        "additionalProperties": false
      },
      "PageMetadata": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "markdownPath": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "url",
          "title",
          "description",
          "markdownPath"
        ],
        "additionalProperties": false
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "siteName": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageMetadata"
            }
          }
        },
        "required": [
          "siteName",
          "url",
          "pages"
        ],
        "additionalProperties": false
      },
      "PageContent": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "markdownPath": {
            "type": "string",
            "minLength": 1
          },
          "markdown": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "url",
          "title",
          "description",
          "markdownPath",
          "markdown"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "instance": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "message",
          "hint"
        ],
        "additionalProperties": false
      }
    }
  }
}
