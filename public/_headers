# Every response the asset layer serves, HTML included (src/lib.rs carries
# this header over when it rewrites a page). No includeSubDomains: that would
# commit every current and future subdomain to HTTPS.
/*
  Strict-Transport-Security: max-age=31536000

# Astro's bundles: each file name carries a content hash, so a new build gets
# new URLs and the old ones never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static media, icons, and scripts under /assets/ and /favicon.ico are not
# content-hashed, so cache for a day and revalidate in the background for a week.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Commit patches are keyed by full git SHA and never change; history.json
# updates on deploy.
/repo/xyz/*.patch
  Cache-Control: public, max-age=31536000, immutable

/repo/xyz/history.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
