---
// What the subway-vis figure needs in <head>, ahead of the renderer: open the
// istheldown feed and fetch the station table early, and preload Hydra.
// public/assets/subway-vis.js's header comment documents the whole figure.
---
        <link rel="preconnect" href="https://istheldown.com">
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
        <script is:inline>
            // Register before the first paint; defer WebGL work until the page fade is over.
            window.__pageTransitionFinished = new Promise(function (resolve) {
                if (!('onpagereveal' in window)) { resolve(); return; }
                window.addEventListener('pagereveal', function (event) {
                    if (event.viewTransition) event.viewTransition.finished.then(resolve, resolve);
                    else resolve();
                }, { once: true });
            });
            // Open the istheldown feed and fetch the station table right away, before the
            // renderer has loaded; assets/subway-vis.js picks these up (messages are queued).
            window.__subway = (function () {
                try {
                    var s = { ws: new WebSocket('wss://istheldown.com/ws?systems=subway&alerts=subway'), queue: [], closed: null, t0: performance.now() };
                    s.onmsg = function (e) { s.queue.push(e.data); };
                    s.ws.addEventListener('message', s.onmsg);
                    s.ws.addEventListener('close', function (e) { s.closed = e.code; });
                    s.stations = fetch('/assets/subway-stations.json').then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
                    s.stations.catch(function () {});
                    return s;
                } catch (e) { return null; }
            })();
        </script>
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/hydra-synth@1.4.0/dist/hydra-synth.js">
        <script is:inline src="/assets/subway-vis.js" defer></script>
