---
// The live mingus taste map on /projects, which opens in its 3D layout by
// default, with a second tab for its SQL playground. ?embed shows only the
// map (or only the editor) and posts input to this page, which
// site/scripts/screensaver.js counts as activity. mingus is its own Worker,
// routed only at alexkan.xyz/mingus in production (see its wrangler.toml). The absolute URL keeps PR
// previews and `wrangler dev` from framing this site's own 404 page instead.
//
// The SQL frame is not in the HTML: it loads DuckDB-Wasm and the tables
// (about 14 MB), so site/scripts/mingus-tabs.js adds it on the first click.
const MINGUS = "https://alexkan.xyz/mingus/";
---
<figure class="mingus-embed">
    <div class="tabs" role="tablist" aria-label="mingus views">
        <button type="button" role="tab" id="mingus-tab-map" aria-controls="mingus-panel-map" aria-selected="true">3D map</button>
        <button type="button" role="tab" id="mingus-tab-sql" aria-controls="mingus-panel-sql" aria-selected="false" tabindex="-1">Query with SQL</button>
    </div>
    <div class="panel" id="mingus-panel-map" role="tabpanel" aria-labelledby="mingus-tab-map">
        <iframe
            src={`${MINGUS}?embed`}
            title="mingus: interactive 3D map of every artist I've listened to, clustered by genre"
            loading="lazy"
            referrerpolicy="no-referrer"
        ></iframe>
    </div>
    <div class="panel sql" id="mingus-panel-sql" role="tabpanel" aria-labelledby="mingus-tab-sql" data-src={`${MINGUS}sql.html?embed`} hidden>
        <p class="loading">Starting DuckDB in your browser…</p>
    </div>
    <figcaption>
        <a href={MINGUS} target="_blank">Full map ↗</a> · <a href={`${MINGUS}sql.html`} target="_blank">SQL playground ↗</a>
    </figcaption>
</figure>

<style>
    /* Same 536px width as the Vesta board (2 x 260px figures + 16px gap) */
    .mingus-embed { width: 536px; max-width: 100%; margin: 1em 0; }
    .tabs { display: flex; gap: 18px; margin-bottom: 6px; font-size: 0.9em; }
    .tabs button {
        font: inherit; color: var(--muted, #666); background: none; border: 0; padding: 2px 0;
        border-bottom: 2px solid transparent; cursor: pointer;
    }
    .tabs button:hover { color: inherit; }
    .tabs button[aria-selected="true"] { color: inherit; border-bottom-color: currentColor; }
    .tabs button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
    .panel {
        position: relative; aspect-ratio: 4 / 3;
        background: color-mix(in srgb, currentColor 6%, var(--bg, Canvas));
        box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 12%, transparent);
    }
    .panel[hidden] { display: none; }
    /* The editor, its examples and results need more height than the map */
    .panel.sql { aspect-ratio: auto; height: 600px; }
    .loading { position: absolute; inset: 0; margin: 0; display: grid; place-items: center; color: var(--muted, #666); font-size: 0.9em; }
    .panel :global(iframe) { position: relative; display: block; width: 100%; height: 100%; border: 0; }
    figcaption { color: var(--muted, #666); font-size: 0.9em; margin-top: 6px; }
    figcaption a { color: inherit; }
    /* Taller on phones, where the map's own controls take more of the frame */
    @media (max-width: 600px) { .panel:not(.sql) { aspect-ratio: 3 / 4; } }
</style>
