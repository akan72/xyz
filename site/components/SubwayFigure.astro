---
// The live istheldown figure on /projects. public/assets/subway-vis.js draws
// it and sets .figs[data-state] to "ready" once it has.
---
<p class="live-caption"><small id="subway-vis-caption" role="status">Loading live transit preview…</small></p>
<div class="figs" data-state="loading">
    <div class="fig"><canvas id="subway-vis" aria-label="Generative figure driven by one subway line's live train positions"></canvas></div>
    <div class="fig map"><canvas id="subway-map" width="520" height="650" aria-label="Map of every subway train right now, with the chosen line highlighted"></canvas></div>
</div>

<style>
    /* Same 260px width as the images on the homepage */
    .figs { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; margin-top: 8px; }
    .fig { width: 260px; max-width: 100%; aspect-ratio: 4 / 5; background: color-mix(in srgb, currentColor 6%, var(--bg, Canvas)); box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 12%, transparent); }
    canvas { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 240ms ease-out; }
    .figs[data-state="ready"] canvas { opacity: 1; }
    .figs:not([data-state="ready"]) canvas { visibility: hidden; }
    @media (prefers-reduced-motion: reduce) { canvas { transition: none; } }
    /* Keep the caption and both figures in flow while the feed loads or fails */
    .live-caption { margin-bottom: 0; }
    small { display: block; min-height: calc(3.2em + 1px); line-height: 1.6; }
    @media (min-width: 600px) { small { min-height: calc(1.6em + 1px); } }
    /* The subway line's bullet, which subway-vis.js adds to the caption */
    small :global(.bullet) { width: 1.4em; height: 1.4em; vertical-align: middle; }
</style>
