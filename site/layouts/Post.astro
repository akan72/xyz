---
// A post in site/content/writing/: its title and date over the content, in
// the shared page layout. site/pages/writing/[slug].astro renders each post.
import Page from "./Page.astro";
import { formatDate, type Post } from "../lib/writing.ts";

interface Props {
    post: Post;
}

const { post } = Astro.props;
const { title, description, date, cover, draft } = post.data;
const url = new URL(`/writing/${post.id}`, Astro.site).href;
const image = cover && new URL(cover, Astro.site).href;
const datePublished = formatDate(date);
// So search engines and AI crawlers can read the title, date and author
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    url,
    ...(image ? { image } : {}),
    author: { "@type": "Person", name: "Alex Kan", url: new URL("/", Astro.site).href },
};
---
<Page title={`${title} | alexkan.xyz`} description={description}>
    <Fragment slot="head">
        <meta property="og:type" content="article">
        <meta property="article:published_time" content={datePublished}>
        {image && <meta property="og:image" content={image}>}
        {image && <meta name="twitter:image" content={image}>}
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </Fragment>
    <article>
        <h1>{title}</h1>
        <p class="byline">
            <time datetime={datePublished}>{datePublished}</time>
            {draft && <strong> · Draft (shown in dev only)</strong>}
        </p>
        <slot />
    </article>
    <p><a class="button" href="/writing">All Writing</a></p>
</Page>

<style>
    article { max-width: 65ch; line-height: 1.6; }
    h1 { font-size: 1.6em; line-height: 1.2; margin: 0 0 4px; }
    .byline { color: var(--muted, #666); margin: 0 0 2em; }
    article :global(img) { display: block; max-width: 100%; height: auto; margin: 1.25em 0; }
    article :global(table) { width: 100%; border-collapse: collapse; margin: 1.25em 0; }
    article :global(th), article :global(td) { padding: 0.4em 0.65em; text-align: left; border-bottom: 1px solid var(--border, #888); }
    article :global(code) { overflow-wrap: anywhere; }
</style>
