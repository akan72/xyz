---
import Page from "../layouts/Page.astro";

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        { "@type": "WebSite", name: "alexkan.xyz", alternateName: "Alex Kan's personal website", url: "https://alexkan.xyz/" },
        {
            "@type": "ProfilePage",
            url: "https://alexkan.xyz/",
            mainEntity: { "@type": "Person", name: "Alex Kan", alternateName: "alexkan", url: "https://alexkan.xyz/", sameAs: ["https://github.com/akan72", "https://www.linkedin.com/in/alexanderkan/"] },
        },
    ],
};
---
<Page title="alexkan.xyz" description="Alex Kan's personal website (alexkan): software projects, NYC transit maps, music visualizations, developer tools, writing, and contact links.">
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <img id="milady" class="milady" src="/assets/milady.jpg" alt="Milady" width="410" height="512">
</Page>

<style>
    .milady { display: block; width: 260px; max-width: 100%; height: auto; margin: 0 0 16px; }
</style>
