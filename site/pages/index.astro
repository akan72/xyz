---
import Page from "../layouts/Page.astro";

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        { "@type": "WebSite", name: "alexkan.xyz", url: "https://alexkan.xyz/" },
        {
            "@type": "ProfilePage",
            url: "https://alexkan.xyz/",
            mainEntity: { "@type": "Person", name: "Alex Kan", url: "https://alexkan.xyz/" },
        },
    ],
};
---
<Page title="alexkan.xyz" description="Alex Kan's personal website.">
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <img id="milady" class="milady" src="/assets/milady.jpg" alt="Milady" width="410" height="512">
</Page>

<style>
    .milady { display: block; width: 260px; max-width: 100%; height: auto; margin: 0 0 16px; }
</style>
