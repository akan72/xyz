---
import Page from "../layouts/Page.astro";
---
<Page title="alexkan.xyz" description="Alex Kan's personal website.">
    <Fragment slot="head">
        <script is:inline type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "WebSite",
                        "name": "alexkan.xyz",
                        "url": "https://alexkan.xyz/"
                    },
                    {
                        "@type": "ProfilePage",
                        "url": "https://alexkan.xyz/",
                        "mainEntity": {
                            "@type": "Person",
                            "name": "Alex Kan",
                            "url": "https://alexkan.xyz/"
                        }
                    }
                ]
            }
        </script>
        <style is:inline>
            :root { color-scheme: light; --bg: #f4f4f4; --fg: #111; --nav: #333; }
            @media (prefers-color-scheme: dark) {
                :root:not([data-theme="light"]) { color-scheme: dark; --bg: #161616; --fg: #e8e8e8; --nav: #c8c8c8; }
            }
            :root[data-theme="dark"] { color-scheme: dark; --bg: #161616; --fg: #e8e8e8; --nav: #c8c8c8; }
            body { background: var(--bg); color: var(--fg); }
            .milady { display: block; width: 260px; max-width: 100%; height: auto; margin: 0 0 16px; }
            button { font: inherit; cursor: pointer; }
            /* Dark mode: outline the cig button instead of the browser's gray fill; light mode keeps the native button */
            @media (prefers-color-scheme: dark) {
                :root:not([data-theme="light"]) .cig-button { background: transparent; color: var(--fg); border: 1px solid #6a6a6a; border-radius: 4px; padding: 2px 7px; }
                :root:not([data-theme="light"]) .cig-button:hover { border-color: #9a9a9a; }
            }
            :root[data-theme="dark"] .cig-button { background: transparent; color: var(--fg); border: 1px solid #6a6a6a; border-radius: 4px; padding: 2px 7px; }
            :root[data-theme="dark"] .cig-button:hover { border-color: #9a9a9a; }
            .cig-box { display: inline-flex; flex-direction: column; align-items: center; }
            .cig { display: block; width: 260px; max-width: 100%; aspect-ratio: 4 / 5; object-fit: cover; margin-top: 12px; }
        </style>
    </Fragment>
            <img id="milady" class="milady" src="./assets/milady.jpg" alt="Milady" width="410" height="512">
            <div class="cig-box">
                <button id="cig-button" class="cig-button" onclick="
                    const btn = this;
                    btn.disabled = true;
                    fetch('/image')
                        .then(r => r.text())
                        .then(url => {
                            const temp = new Image();
                            temp.onload = () => {
                                document.getElementById('cig').src = url;
                                btn.disabled = false;
                            };
                            temp.src = url;
                        });
                ">
                    Get Random Cig
                </button>
                <img id="cig" class="cig" src="./assets/cig.jpg" alt="Cigawrette">
            </div>
</Page>
