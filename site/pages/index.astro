---
import Page from "../layouts/Page.astro";

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        { "@type": "WebSite", name: "alexkan.xyz", url: "https://alexkan.xyz/" },
        {
            "@type": "ProfilePage",
            url: "https://alexkan.xyz/",
            mainEntity: { "@type": "Person", name: "Alex Kan", url: "https://alexkan.xyz/" },
        },
    ],
};
---
<Page title="alexkan.xyz" description="Alex Kan's personal website.">
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <img id="milady" class="milady" src="/assets/milady.jpg" alt="Milady" width="410" height="512">
    <div class="cig-box">
        <button id="cig-button" class="cig-button">Get Random Cig</button>
        <img id="cig" class="cig" src="/assets/cig.jpg" alt="Cigawrette">
    </div>
</Page>

<style>
    .milady { display: block; width: 260px; max-width: 100%; height: auto; margin: 0 0 16px; }
    .cig-box { display: inline-flex; flex-direction: column; align-items: center; }
    .cig { display: block; width: 260px; max-width: 100%; aspect-ratio: 4 / 5; object-fit: cover; margin-top: 12px; }
    button { font: inherit; cursor: pointer; }
    /* Dark mode outlines the button instead of the browser's gray fill */
    :global(:root[data-theme="dark"]) .cig-button { background: transparent; color: var(--fg); border: 1px solid #6a6a6a; border-radius: 4px; padding: 2px 7px; }
    :global(:root[data-theme="dark"]) .cig-button:hover { border-color: #9a9a9a; }
    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) .cig-button { background: transparent; color: var(--fg); border: 1px solid #6a6a6a; border-radius: 4px; padding: 2px 7px; }
        :global(:root:not([data-theme="light"])) .cig-button:hover { border-color: #9a9a9a; }
    }
</style>
