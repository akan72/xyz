---
import Page from "../layouts/Page.astro";
---
<Page title="Page Not Found :(" noindex>
    <div class="error-card"><div class="container">
        <h1>Not found <span>:(</span></h1>
        <img src="/assets/cig.jpg" alt="Cigawrette" width="400" height="400">
        <p>Sorry, but the page you were trying to view does not exist.</p>
        <p>It looks like this was the result of either:</p>
        <ul>
            <li>a mistyped address</li>
            <li>an out-of-date link</li>
        </ul>
        <p><a href="/">Home</a> · <a href="/llms.txt">Site guide</a></p>
    </div></div>
</Page>

<style>
    :global(::-moz-selection) {
        background: #b3d4fc;
        text-shadow: none;
    }

    :global(::selection) {
        background: #b3d4fc;
        text-shadow: none;
    }

    :global(:root) {
        color-scheme: light;
        --text: #737373;
        --card: #fcfcfc;
        --border: #b3b3b3;
        --shadow: 0 1px 10px #a7a7a7, inset 0 1px 0 #fff;
        --heading: #737373;
        --heading-muted: #bbb;
    }

    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) {
            color-scheme: dark;
            --text: #a8a8a8;
            --card: #1f1f1f;
            --border: #333;
            --shadow: 0 1px 10px #000, inset 0 1px 0 #2a2a2a;
            --heading: #e8e8e8;
            --heading-muted: #666;
        }
    }

    :global(:root[data-theme="dark"]) {
        color-scheme: dark;
        --text: #a8a8a8;
        --card: #1f1f1f;
        --border: #333;
        --shadow: 0 1px 10px #000, inset 0 1px 0 #2a2a2a;
        --heading: #e8e8e8;
        --heading-muted: #666;
    }

    :global(html) {
        padding: 0;
        font-size: 16px;
        line-height: normal;
        color: var(--text);
        /* The page background is site.css's --bg, like every other page */
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
    }

    .error-card {
        color: var(--text);
        font-size: 20px;
        line-height: 1.4;
        max-width: 500px;
        padding: 30px 20px 50px;
        border: 1px solid var(--border);
        border-radius: 4px;
        margin: 0 auto;
        box-shadow: var(--shadow);
        background: var(--card);
    }

    h1 {
        margin: 0 10px;
        font-size: 50px;
        text-align: center;
        color: var(--heading);
    }

    .error-card img { display: block; max-width: 100%; height: auto; }

    h1 span {
        white-space: nowrap;
        color: var(--heading-muted);
    }

    h3 {
        margin: 1.5em 0 0.5em;
    }

    p {
        margin: 1em 0;
    }

    ul {
        padding: 0 0 0 40px;
        margin: 1em 0;
    }

    .container {
        max-width: 380px;
        margin: 0 auto;
    }

</style>
