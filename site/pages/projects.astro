---
import { getCollection } from "astro:content";
import SubwayFigure from "../components/SubwayFigure.astro";
import SubwayHead from "../components/SubwayHead.astro";
import Page from "../layouts/Page.astro";

// Each project is a YAML file in site/content/projects/ (schema in site/content.config.ts)
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const taken = new Map<number, string>();
for (const { id, data } of projects) {
    if (taken.has(data.order)) throw new Error(`projects ${taken.get(data.order)} and ${id} both have order: ${data.order}`);
    taken.set(data.order, id);
}

type Years = (typeof projects)[number]["data"]["years"];
const years = (y: Years) =>
    y.kind === "since" ? `(${y.start}-Present)` : y.kind === "range" ? `(${y.start}-${y.end})` : `(${y.year})`;

const escape = (text: string) => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
const stack = (items: string[]) => items.map(escape).join(" &middot; ");
---
<Page title="Projects | alexkan.xyz" description="Things I've built.">
    <Fragment slot="head-scripts">
        {projects.some((p) => p.data.media === "subway-vis") && <SubwayHead />}
    </Fragment>
    <Fragment slot="head">
        <style is:inline>
            :root { color-scheme: light; }
            @media (prefers-color-scheme: dark) {
                :root:not([data-theme="light"]) { color-scheme: dark; --bg: #161616; --fg: #e8e8e8; --link: #8ab4f8; --visited: #c58af9; --muted: #9a9a9a; }
            }
            :root[data-theme="dark"] { color-scheme: dark; --bg: #161616; --fg: #e8e8e8; --link: #8ab4f8; --visited: #c58af9; --muted: #9a9a9a; }
            body { max-width: 720px; margin: 40px auto; padding: 0 16px; background: var(--bg, Canvas); color: var(--fg, CanvasText); }
            a { color: var(--link, LinkText); }
            a:visited { color: var(--visited, VisitedText); }
            /* The stack line under each description */
            .meta { color: var(--muted, #666); font-size: 0.9em; margin-top: -0.4em; }
            /* The live istheldown figure: same 260px width as the images on the homepage */
            .figs { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; margin-top: 8px; }
            .fig { width: 260px; max-width: 100%; aspect-ratio: 4 / 5; background: color-mix(in srgb, currentColor 6%, var(--bg, Canvas)); box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 12%, transparent); }
            .fig canvas { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 240ms ease-out; }
            .figs[data-state="ready"] canvas { opacity: 1; }
            @media (prefers-reduced-motion: reduce) { .fig canvas { transition: none; } }
            /* Keep the caption and both figures in flow while the feed loads or fails. */
            .live-caption { margin-bottom: 0; }
            .live-caption small { display: block; min-height: calc(3.2em + 1px); line-height: 1.6; }
            @media (min-width: 600px) { .live-caption small { min-height: calc(1.6em + 1px); } }
            .figs:not([data-state="ready"]) canvas { visibility: hidden; }
            .bullet { width: 1.4em; height: 1.4em; vertical-align: middle; }
            /* Wrap descriptions at the right edge of the figure and map (2 x 260px + 16px gap),
               and never past 70ch in case the font gets wider */
            ul p { max-width: min(536px, 70ch); }
        </style>
    </Fragment>
        <h2> Projects </h2>
        <ul>
            {projects.map(({ data }) => (
            <li> <a href={data.url} target="_blank">{data.name}</a> <span class="years">{years(data.years)}</span>
                {data.media === "subway-vis" && <SubwayFigure />}
                <p set:html={data.about} />
                <p class="meta" set:html={stack(data.stack)} />
            </li>
            ))}
        </ul>
</Page>
