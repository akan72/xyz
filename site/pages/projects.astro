---
import { getCollection, render } from "astro:content";
import CigPicker from "../components/CigPicker.astro";
import MingusEmbed from "../components/MingusEmbed.astro";
import RepoFigure from "../components/RepoFigure.astro";
import SubwayFigure from "../components/SubwayFigure.astro";
import SubwayHead from "../components/SubwayHead.astro";
import VestaPreview from "../components/VestaPreview.astro";
import Page from "../layouts/Page.astro";

// Each project is a Markdown file in site/content/projects/ (schema in site/content.config.ts)
const entries = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const orders = new Map<number, string>();
for (const { id, data } of entries) {
    const other = orders.get(data.order);
    if (other) throw new Error(`projects ${other} and ${id} both have order: ${data.order}`);
    orders.set(data.order, id);
}
const projects = await Promise.all(entries.map(async (entry) => ({ ...entry.data, Content: (await render(entry)).Content })));

type Years = (typeof projects)[number]["years"];
const years = (y: Years) =>
    y.kind === "since" ? `(${y.start}-Present)` : y.kind === "range" ? `(${y.start}-${y.end})` : `(${y.year})`;

// Alt text for each project icon
const icons: Record<NonNullable<(typeof projects)[number]["icon"]>, string> = { vim: "Vim logo" };
---
<Page title="Projects | alexkan.xyz" description="Things I've built.">
    <Fragment slot="head-scripts">
        {projects.some((p) => p.media === "subway-vis") && <SubwayHead />}
    </Fragment>
    <h1>Projects</h1>
    <ul>
        {projects.map(({ name, url, Content, media, icon, stack, ...project }) => (
            <li>
                <a href={url} target="_blank">{name}</a> <span class="years">{years(project.years)}</span>
                {icon && <img class="icon" src={`/assets/icons/${icon}.svg`} alt={icons[icon]} width="20" height="20">}
                <Content />
                <p class="meta">{stack.join(" · ")}</p>
                {/* Each project's demo, under its description and stack */}
                {media === "subway-vis" && <SubwayFigure />}
                {media === "cig-picker" && <CigPicker />}
                {media === "vesta-demo" && <VestaPreview />}
                {media === "mingus-3d" && <MingusEmbed />}
                {/* Opens at the move from Fly.io to Cloudflare Workers */}
                {media === "repo-history" && <RepoFigure at="157e55a" />}
            </li>
        ))}
    </ul>
</Page>

<style>
    /* The same gap after every project, whether it ends with its stack line or a demo */
    li > :global(:last-child) { margin-bottom: 1em; }
    /* The stack line under each description */
    .meta { color: var(--muted, #666); font-size: 0.9em; margin-top: -0.4em; }
    /* Logo after the years, sized to the text */
    .icon { width: 1.1em; height: 1.1em; vertical-align: -0.2em; margin-left: 0.15em; }
    /* Wrap descriptions at the right edge of the figure (2 x 260px + 16px gap),
       and never past 70ch in case the font gets wider. :global reaches the
       <p> each project's Markdown renders. */
    ul :global(p) { max-width: min(536px, 70ch); }
</style>
